        <mxCell id="lbcl8" value="** LBCL：最后一个数据时钟脉冲可选" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#516173;" vertex="1" parent="1"><mxGeometry x="690" y="671" width="340" height="24" as="geometry"/></mxCell>

        <mxCell id="idle-label8" value="Idle" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#207A36;" vertex="1" parent="1"><mxGeometry x="160" y="712" width="55" height="30" as="geometry"/></mxCell>
        <mxCell id="idle8" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#27823A;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="745" as="sourcePoint"/><mxPoint x="1032" y="717" as="targetPoint"/><Array as="points"><mxPoint x="220" y="745"/><mxPoint x="220" y="717"/><mxPoint x="800" y="717"/><mxPoint x="800" y="745"/><mxPoint x="858" y="745"/><mxPoint x="858" y="717"/></Array></mxGeometry></mxCell>
        <mxCell id="idle-text8" value="Idle frame：整帧逻辑 1（含停止位）" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#207A36;" vertex="1" parent="1"><mxGeometry x="330" y="722" width="420" height="23" as="geometry"/></mxCell>
        <mxCell id="idle-start8" value="Start / 0" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#8A4B08;" vertex="1" parent="1"><mxGeometry x="796" y="748" width="66" height="22" as="geometry"/></mxCell>

        <mxCell id="break-label8" value="Break" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#B42318;" vertex="1" parent="1"><mxGeometry x="160" y="800" width="55" height="30" as="geometry"/></mxCell>
        <mxCell id="break8" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#C2261B;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="787" as="sourcePoint"/><mxPoint x="1032" y="787" as="targetPoint"/><Array as="points"><mxPoint x="220" y="787"/><mxPoint x="220" y="820"/><mxPoint x="800" y="820"/><mxPoint x="800" y="787"/><mxPoint x="858" y="787"/><mxPoint x="858" y="820"/><mxPoint x="916" y="820"/><mxPoint x="916" y="787"/></Array></mxGeometry></mxCell>
        <mxCell id="break-text8" value="Break frame：一整帧逻辑 0" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fontColor=#B42318;" vertex="1" parent="1"><mxGeometry x="350" y="789" width="350" height="24" as="geometry"/></mxCell>
        <mxCell id="break-stop8" value="Stop / 1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#207A36;" vertex="1" parent="1"><mxGeometry x="796" y="762" width="66" height="22" as="geometry"/></mxCell>
        <mxCell id="break-start8" value="Start / 0" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#8A4B08;" vertex="1" parent="1"><mxGeometry x="854" y="823" width="66" height="22" as="geometry"/></mxCell>
        <mxCell id="break-next8" value="数据" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#37516B;" vertex="1" parent="1"><mxGeometry x="911" y="762" width="126" height="22" as="geometry"/></mxCell>

        <mxCell id="card8" value="&lt;b&gt;&lt;font style=&quot;font-size:21px;&quot;&gt;8 位帧参数&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;① &lt;b&gt;USART_CR1.M = 0&lt;/b&gt;&lt;br&gt;② Start bit：TX = 0；Stop bit：TX = 1&lt;br&gt;③ Bit0 → Bit7（LSB first）&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;启用校验时，Bit7 位置用于 parity bit。&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#E8F6FD;strokeColor=#82CAE8;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="1055" y="522" width="377" height="188" as="geometry"/></mxCell>
        <mxCell id="card-clock" value="&lt;b&gt;&lt;font style=&quot;font-size:21px;&quot;&gt;共享时钟与 LBCL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;⑥ 发送器和接收器共用 &lt;b&gt;USART_BRR&lt;/b&gt;。&lt;br&gt;&lt;br&gt;• &lt;b&gt;TE&lt;/b&gt;：使能发送器时钟&lt;br&gt;• &lt;b&gt;RE&lt;/b&gt;：使能接收器时钟&lt;br&gt;• &lt;b&gt;LBCL&lt;/b&gt;：控制最后一个数据位的时钟脉冲" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EAF8EE;strokeColor=#8ED6A3;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#174B2A;" vertex="1" parent="1"><mxGeometry x="1055" y="720" width="377" height="200" as="geometry"/></mxCell>

        <mxCell id="key-bg" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0F5;strokeColor=#E998B4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8" y="932" width="1000" height="140" as="geometry"/></mxCell>
        <mxCell id="key-title" value="补充讲解&lt;br&gt;关键要点" style="text;html=1;align=center;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#B42318;" vertex="1" parent="1"><mxGeometry x="20" y="944" width="120" height="66" as="geometry"/></mxCell>
        <mxCell id="key-left" value="① M 选择 8 / 9 位字长&lt;br&gt;② Start = 0，Stop = 1&lt;br&gt;③ 数据从 Bit0 开始发送（LSB first）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#26384A;" vertex="1" parent="1"><mxGeometry x="145" y="948" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="key-right" value="④ Idle：整帧逻辑 1，随后进入下一 Start bit&lt;br&gt;⑤ Break：一帧逻辑 0，结束后插入 1 / 2 位逻辑 1&lt;br&gt;⑥ USART_BRR 共用；TE / RE 分别使能收发时钟" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#26384A;" vertex="1" parent="1"><mxGeometry x="545" y="948" width="450" height="105" as="geometry"/></mxCell>

        <mxCell id="legend-bg" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#E8C46A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1018" y="932" width="414" height="140" as="geometry"/></mxCell>
        <mxCell id="legend-title" value="图例与脚注" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=1;fontColor=#8A4B08;" vertex="1" parent="1"><mxGeometry x="1035" y="944" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="legend" value="绿色：Idle；红色：Break&lt;br&gt;紫色：可选校验位的位置&lt;br&gt;虚线脉冲：由 LBCL 控制&lt;br&gt;数据区双线：电平可为 0 或 1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;fillColor=#FFFFFF;strokeColor=#B9C6D2;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="1035" y="978" width="380" height="80" as="geometry"/></mxCell>
