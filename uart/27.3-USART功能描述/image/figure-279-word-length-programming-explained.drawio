<mxCell id="break-data-low9" value="" style="endArrow=none;strokeColor=#C2261B;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="974" y="425" as="sourcePoint"/><mxPoint x="1032" y="425" as="targetPoint"/></mxGeometry></mxCell>
